# 복사해서 .env 로 저장한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않음)
# monitoring/run-msa.ps1 이 실행 시 자동으로 읽습니다.

# user-service: spring.security.user.password (BCrypt 해시)
BCRYPT_HASH=
# config-service: 암호화용 keystore
ENCRYPT_KEYSTORE_LOCATION=file:///D:/lg6th/keystore/apiEncryptionKey.jks
KEYSTORE_PASSWORD=
# JWT 서명 키 (Config Server 를 안 쓸 때만)
TOKEN_SECRET=
