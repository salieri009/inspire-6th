# 실제 .env 는 커밋하지 않고, "어떤 키가 필요한지"만 이 파일로 공유한다.
# 사용법: 이 파일을 .env 또는 .env.development 로 복사해서 값을 채운다.

# 개발 환경에서 사용할 API 주소 (비워두면 상대경로 요청)
# 블로그는 json-server 목업 서버(npm run server)가 4000 포트에서 뜬다.
REACT_APP_API_URL=http://localhost:4000

# 운영 빌드에서 사용할 API 주소
REACT_APP_BACKEND_URL=https://api.example.com

# 날씨 페이지(OpenWeatherMap)에서 사용하는 API 키
# https://openweathermap.org/api 에서 발급받아 .env.development.local 에 채운다.
REACT_APP_OPENWEATHER_API_KEY=

# 지도+날씨 페이지(/map-weather)의 카카오맵에서 사용하는 JavaScript 앱키
# https://developers.kakao.com 에서 발급받아 .env.development.local 에 채운다.
# 카카오 개발자 콘솔 > 앱 설정 > 플랫폼 > Web 에 사용 중인 도메인(예: http://localhost:3004)을 등록해야 한다.
REACT_APP_KAKAO_MAP_KEY=27a05b97bca5eb67d11f07e75c8d8af8
